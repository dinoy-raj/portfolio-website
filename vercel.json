{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:app([a-z0-9-]+)", "destination": "/index.html" },
    { "source": "/:app([a-z0-9-]+)/:page(privacypolicy|termsofservice)", "destination": "/index.html" }
  ]
}
